#--------------------------------------------------------------------
# vaculik.info – environment template
# Copy to .env and fill in. The .env file is never committed.
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false
app.appTimezone = 'Europe/Bratislava'

#--------------------------------------------------------------------
# DATABASE (Websupport: credentials from the hosting panel; use utf8mb4)
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = vaculik_info
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

# Local development without MySQL: comment the block above and use SQLite.
# database.default.DBDriver = SQLite3
# database.default.database = database.sqlite   # relative to writable/
# database.default.hostname =

#--------------------------------------------------------------------
# SECURITY – generate with: php spark key:generate --show
#--------------------------------------------------------------------
encryption.key =

#--------------------------------------------------------------------
# SESSION (database handler keeps logins on shared hosting after deploys)
#--------------------------------------------------------------------
session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.savePath = null

#--------------------------------------------------------------------
# EMAIL (Websupport SMTP) – used for password resets and notifications
#--------------------------------------------------------------------
email.fromEmail = 'rodina@vaculik.info'
email.fromName = 'vaculik.info'
email.protocol = smtp
email.SMTPHost = smtp.websupport.sk
email.SMTPPort = 465
email.SMTPCrypto = ssl
email.SMTPUser =
email.SMTPPass =

#--------------------------------------------------------------------
# INTEGRATIONS (phase 1+)
#--------------------------------------------------------------------
# Web Push (generate once: npx web-push generate-vapid-keys)
push.vapidPublicKey =
push.vapidPrivateKey =
push.subject = 'mailto:rodina@vaculik.info'

# Google Calendar (phase 1: ICS URLs; phase 2: OAuth)
google.clientId =
google.clientSecret =

# Edupage e-mail notifications are read from this IMAP mailbox by cron
edupage.imapHost =
edupage.imapUser =
edupage.imapPass =

# Assistant (phase 3) – Anthropic API, see docs/ARCHITEKTURA.md section 7
ANTHROPIC_API_KEY =
assistant.model = 'claude-opus-5-5'

# Cron on the server (every 5–15 minutes): php spark app:tick
